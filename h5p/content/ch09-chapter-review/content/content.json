      "metadata": {
        "title": "For orbital angular-momentum quantum number ℓ, how many values may mℓ take?",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>For orbital angular-momentum quantum number ℓ, how many values may mℓ take?</p>",
        "media": {
          "disableImageZooming": false
        },
        "answers": [
          {
            "text": "<div>2ℓ + 1, from −ℓ through +ℓ.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>ℓ, from 0 through ℓ − 1.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>2ℓ, excluding zero.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Only one value, mℓ = ℓ.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
        ],

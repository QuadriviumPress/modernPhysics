      "metadata": {
        "title": "Why can both fusion of light nuclei and fission of heavy nuclei release energy?",
        "license": "CC BY-NC-SA",
        "licenseVersion": "4.0",
        "contentType": "Multiple Choice"
      },
      "params": {
        "question": "<p>Why can both fusion of light nuclei and fission of heavy nuclei release energy?</p>",
        "media": {
          "type": {
            "library": "H5P.Image 1.1",
            "subContentId": "1ae60365-c7ee-44b3-a394-b71802a85966",
            "metadata": {
              "title": "Binding energy per nucleon versus mass number, peaking near iron and nickel.",
              "license": "CC BY-NC-SA",
              "licenseVersion": "4.0",
              "contentType": "Image"
            },
            "params": {
              "contentName": "Image",
              "alt": "Binding energy per nucleon versus mass number, peaking near iron and nickel.",
              "decorative": false,
              "file": {
                "path": "images/ch13-binding-energy-curve.svg",
                "mime": "image/svg+xml",
                "width": 551,
                "height": 367
              }
            }
          },
          "disableImageZooming": false
        },
        "answers": [
          {
            "text": "<div>Both move the products toward higher binding energy per nucleon near iron and nickel.</div>",
            "correct": true,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Yes—this is one of the correct choices.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Both convert every nucleon entirely into radiation.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Both eliminate the strong nuclear interaction.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          },
          {
            "text": "<div>Both always increase the total rest mass of the products.</div>",
            "correct": false,
            "tipsAndFeedback": {
              "tip": "",
              "chosenFeedback": "Not this one. Revisit the chapter summary and try again.",
              "notChosenFeedback": ""
            }
          }
        ],

{
  "name": "modern-physics",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x",
    "npm": ">=10 <11"
  },
  "description": "MyST Markdown textbook on Modern Physics",
  "scripts": {
    "check:toolchain": "node scripts/check-toolchain.mjs",
    "prestart": "npm run check:toolchain",
    "start": "myst start",
    "prebuild": "npm run check:toolchain",
    "build": "myst build --html",
    "precheck": "npm run check:toolchain",
    "check": "npm run check:project && npm test && npm run build -- --check-links",
    "check:project": "node scripts/validate-project.mjs",
    "check:figures": "scripts/check-figures.sh",
    "test": "node tests/export-plugin.test.mjs",
    "build:exports": "scripts/build-exports.sh all",
    "build:pdf": "scripts/build-exports.sh pdf",
    "build:chapters": "scripts/build-exports.sh chapters",
    "build:docx": "scripts/build-exports.sh docx"
  },
  "devDependencies": {
    "mystmd": "1.10.1"
  }
}
